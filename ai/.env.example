# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL (Usado quando não estiver em modo Mock)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omniconnect

# Backend API
BACKEND_API_URL=http://localhost:3000
BOT_API_KEY=your_bot_api_key

# WhatsApp Cloud API (T19 Webhook)
WA_VERIFY_TOKEN=your_verify_token
WA_ACCESS_TOKEN=your_access_token
WA_PHONE_NUMBER_ID=your_phone_number_id

# Servidor
PORT=3001
NODE_ENV=development
