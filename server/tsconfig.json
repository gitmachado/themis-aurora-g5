{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@types/*": ["src/types/*"],
      "@dtos/*": ["src/types/dtos/*"],
      "@dtos": ["src/types/dtos/index.ts"],
      "@models/*": ["src/types/models/*"],
      "@models": ["src/types/models/index.ts"],
      "@enums/*": ["src/types/enums/*"],
      "@enums": ["src/types/enums/index.ts"],
      "@common/*": ["src/types/common/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
