# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=omniconnect_db

# App Config
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_IN=7d

# Bot Security
# Required when NODE_ENV=production
BOT_API_KEY=your_bot_api_key_here

# Supabase
# Required for email auth and Supabase Storage-backed documents
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_AUTH_REDIRECT_URL=omniconnect://auth/callback
SUPABASE_STORAGE_BUCKET=omniconnect-documents
SUPABASE_STORAGE_SIGNED_URL_EXPIRES_IN=300

# Docker/Postgres specific (used by postgres image in docker-compose)
POSTGRES_DB=omniconnect_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
