# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=themis_db

# App Config
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_IN=7d
GOOGLE_CLIENT_ID=your_google_web_client_id_here
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Bot Security
# Required when NODE_ENV=production
BOT_API_KEY=your_bot_api_key_here

# Docker/Postgres specific (used by postgres image in docker-compose)
POSTGRES_DB=themis_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"
